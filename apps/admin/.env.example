# Backend API URL
# Local: http://localhost:3000
# Production: https://your-backend.onrender.com
VITE_BASE_URL=http://localhost:3000

# BSC RPC (Ankr free tier)
VITE_BSC_RPC_ANKR=https://rpc.ankr.com/bsc

# TRON RPC (Ankr free tier)
VITE_TRON_API_ANKR=https://rpc.ankr.com/tron
